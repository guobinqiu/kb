# ========= 构建 =========
USE_CN_MIRROR=true
IMAGE_TAG=dev

# ======== Search OpenTelemetry / Collector / Jaeger ========
# KB API Search traces use OTLP/HTTP over kb-net; kb_api is set in deploy.yaml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SDK_DISABLED=false

# ======= LLM ========
OPENAI_API_KEY=change-me

# ========= mineru：文档解析 ========
MINERU_API_KEY=

# ======== 硅基流动 Embedding、Rerank =========
# 国内
SILICONFLOW_CN_API_KEY=

# 海外
SILICONFLOW_INTL_API_KEY=

# ========== 云向量库 =========
QDRANT_CLOUD_API_KEY=
MILVUS_CLOUD_TOKEN=

# ======== 管理后台登录密码 ========
RAG_ADMIN_PASSWORD=change-me

# ======== KB API ========
KB_DATABASE_URL=postgresql://rag:rag@postgres:5432/rag
KB_ADMIN_NAME=admin
KB_ADMIN_PASSWORD=change-me
KB_TOKEN_SECRET=change-me
SERVICE_API_KEY=change-me

# ======== RabbitMQ ========
RABBITMQ_USER=kb
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://kb:change-me@rabbitmq:5672/%2F

# ======== KB MinIO ========
KB_MINIO_ENDPOINT=minio:9000
KB_MINIO_ACCESS_KEY=minioadmin
KB_MINIO_SECRET_KEY=minioadmin
KB_MINIO_BUCKET=kb-files
KB_MINIO_SECURE=false
KB_MINIO_PUBLIC_URL=http://localhost:9000

# ======== 本地 MinIO ========
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
